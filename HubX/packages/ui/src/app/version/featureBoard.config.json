    {
      "module": "报价工作台",
      "domain": "销售域",
      "isPlanned": false,
      "scope": "",
      "features": [
        {
          "name": "Stage1 功能清单",
          "description": "两级模块+子功能（数据流转可挂端/平台）。Excel 导入导出。提交评估前至少一行。文件流转按标准五列解析。"
        },
        {
          "name": "Stage2 人天评估",
          "description": "数据流转：岗位人天、切片、WASD。文件流转：评估文件+评估工期+总人天。主报价完成评估人天须>0。"
        },
        {
          "name": "Stage3 销售报价",
          "description": "增项、工期（工作日）、付款期次、含税总价。利润率是统计项不是输入。现网仍为 Stage3WebAutomation，将按 PRD 收口。"
        },
        {
          "name": "Stage4 审批盖章",
          "description": "目标：提交时拍审批配置快照，会签通过→待盖章→已盖章。现网仍写死三人会签。已确认后生成合同向导（阶段3已接）。"
        },
        {
          "name": "报价状态机",
          "description": "现网 13 态。目标：草稿/待评估/待报价/待审核/已驳回/待盖章/已盖章/已发出/已确认/已废止；过期为已发出标记。见 ADR 0001–0065。"
        },
        {
          "name": "角色切换器",
          "description": "RoleSwitcher：6 角色模拟。目标责任人改为本单评估人/销售（配置默认，可改指）。"
        },
        {
          "name": "报价中心",
          "description": "QuotationCenter：列表。目标按新状态筛+待我处理+过期标记，无已完成桶。"
        }
      ],
      "planned": [
        {
          "name": "状态机按 PRD 收口（已确认/已废止/过期标记）",
          "status": "已设计"
        },
        {
          "name": "数据流转与文件流转双来源",
          "status": "已设计"
        },
        {
